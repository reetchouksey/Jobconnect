{
  "name": "jobconnect",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "JobConnect - A modern Job Portal built with React 19, Redux Toolkit & Tailwind CSS",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "server": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "server:seed": "npm --prefix server run seed",
    "dev:all": "concurrently -k -n CLIENT,SERVER -c cyan,magenta \"npm run dev\" \"npm run server\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^6.0.1"
  }
}
